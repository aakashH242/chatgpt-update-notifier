#!/usr/bin/env bash
set -euo pipefail

# app names this tool in messages and in its per-user directories.
app=chatgpt-update-notifier
# notifier_version must match VERSION in the same release archive.
notifier_version=1.2.2
# core_modules is the complete, ordered set of version-matched implementation files.
# Keeping one list prevents install and self-update checks inside this script from drifting.
core_modules=(package-operation.sh rollback.sh manager.sh)
# config_defaults is the ordered schema used by both parsing and append-only migrations.
# Keeping every default here prevents a new setting from acquiring different fallback values.
config_defaults=(
  interval_minutes=60          # Check once an hour unless the user chooses another interval.
  notification_seconds=15      # Keep alerts visible for fifteen seconds by default.
  play_sound=true              # Ask the desktop to play its standard notification sound.
  shutdown_timeout_seconds=10  # Give ChatGPT ten seconds to close normally.
  assume_yes=false             # Keep terminal confirmation enabled unless explicitly disabled.
  stop_app=true                # Prefer closing a running app before a one-click update.
  stop_delay_seconds=30        # Give the user thirty seconds to save work before closing.
  force_kill=false             # Never force-close the app without explicit consent.
  restart_app=true             # Restore an app that was running before the update.
  restart_delay_seconds=30     # Give the user thirty seconds before restarting an open app.
  rollback_versions=3          # Keep the three newest valid rollback packages by default.
  enable_gui=true              # Prefer an available native manager dialog over the terminal menu.
)
# These variables are assigned from config_defaults through printf -v. Declaring them
# explicitly keeps nounset behavior and static analysis clear without repeating values.
# shellcheck disable=SC2034 # The sourced package-operation module reads lifecycle settings.
declare interval_minutes notification_seconds play_sound shutdown_timeout_seconds
# shellcheck disable=SC2034 # These validated settings are consumed by sourced lifecycle code.
declare assume_yes stop_app stop_delay_seconds force_kill restart_app restart_delay_seconds
# shellcheck disable=SC2034 # The sourced rollback module applies this retention limit.
declare rollback_versions
# shellcheck disable=SC2034 # The sourced manager module reads this validated preference.
declare enable_gui
# missing_config_defaults is rebuilt by read_config for the installer's migration check.
missing_config_defaults=()

# Restore every runtime preference from the single schema above.
# entry is trusted project data; key and value split its first equals sign.
set_config_defaults() {
  local entry key value
  for entry in "${config_defaults[@]}"; do
    key=${entry%%=*}
    value=${entry#*=}
    printf -v "$key" '%s' "$value"
  done
}
set_config_defaults
# upgrade_step_one and upgrade_step_two hold the exact package commands shown and run.
# A second step is needed only for APT's separate metadata refresh and install.
upgrade_step_one=()
upgrade_step_two=()
# config_file is user-editable data; it is parsed as key=value text, never sourced as shell code.
config_file="${XDG_CONFIG_HOME:-$HOME/.config}/$app/config"
# state_dir holds check timestamps and per-version silence markers across timer runs.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/$app"
# cache_dir holds disposable APT/checkupdates metadata, separate from system package state.
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/$app"
# project_url is used for release archives and user-facing recovery links.
project_url='https://github.com/aakashH242/chatgpt-update-notifier'
# latest_version_url is the small remote VERSION file checked on each timer tick.
latest_version_url='https://raw.githubusercontent.com/aakashH242/chatgpt-update-notifier/refs/heads/main/VERSION'
# notification_options holds the shared notify-send arguments rebuilt for each alert.
notification_options=()
# apt_options contains the isolated signed-source settings shared by checks and snapshots.
apt_options=()

# Write a diagnostic with a consistent prefix; callers decide whether to retry or stop.
error() { printf '%s: %s\n' "$app" "$*" >&2; }

# Accept a short base-10 unsigned integer inside the inclusive bounds supplied by the caller.
# The digit-length guard prevents arithmetic overflow before Bash evaluates the value.
valid_uint() {
  [[ $1 =~ ^[0-9]{1,5}$ ]] || return 1
  (( 10#$1 >= $2 && 10#$1 <= $3 ))
}

# Accept only the two literal boolean values supported by the flat config format.
valid_bool() { [[ $1 == true || $1 == false ]]; }

# Validate one supported config value and place its canonical representation in
# validated_config_value. Both file parsing and the manager settings editor use
# this boundary so their accepted values cannot drift apart.
validate_config_value() {
  local key=$1 value=$2
  case $key in
    interval_minutes)
      valid_uint "$value" 15 10080 || { error 'interval_minutes must be 15–10080'; return 1; }
      value=$((10#$value))
      (( value % 15 == 0 )) || {
        error 'interval_minutes must be a multiple of 15 between 15 and 10080'
        return 1
      }
      ;;
    notification_seconds)
      valid_uint "$value" 1 600 || { error 'notification_seconds must be between 1 and 600'; return 1; }
      value=$((10#$value))
      ;;
    shutdown_timeout_seconds)
      valid_uint "$value" 1 60 || { error 'shutdown_timeout_seconds must be between 1 and 60'; return 1; }
      value=$((10#$value))
      ;;
    play_sound|assume_yes|stop_app|force_kill|restart_app|enable_gui)
      valid_bool "$value" || { error "$key must be true or false"; return 1; }
      ;;
    stop_delay_seconds|restart_delay_seconds)
      valid_uint "$value" 0 180 || { error "$key must be between 0 and 180"; return 1; }
      value=$((10#$value))
      ;;
    rollback_versions)
      valid_uint "$value" 0 1000 || { error 'rollback_versions must be between 0 and 1000'; return 1; }
      value=$((10#$value))
      ;;
    *) error "Unsupported config key: $key"; return 1 ;;
  esac
  validated_config_value=$value
}

# Build the options shared by every alert. sound-name is a standard desktop hint;
# notification servers that do not support sounds may safely ignore it.
set_notification_options() {
  notification_options=(--app-name='ChatGPT Update Notifier' --expire-time="$((notification_seconds * 1000))")
  if [[ $play_sound == true ]]; then
    notification_options+=(--hint=string:sound-name:message-new-instant)
  else
    notification_options+=(--hint=boolean:suppress-sound:true)
  fi
  return 0
}

# Send a non-actionable alert with the current display-time and sound preferences.
send_notification() {
  set_notification_options
  notify-send "${notification_options[@]}" "$@"
}

# Read the host distribution and set distro for package-manager dispatch.
# Only the four distributions with supported package paths are accepted.
detect_distro() {
  [[ -r /etc/os-release ]] || { error 'Cannot read /etc/os-release'; return 1; }
  . /etc/os-release
  case "$ID" in
    ubuntu|debian|fedora|arch) distro=$ID ;;
    *) error "Unsupported distribution: $ID"; return 1 ;;
  esac
}

# Parse the flat config without executing it. Set every supported runtime preference.
# Return 2 for a missing/unreadable file and 1 for malformed data so warn_config can explain it.
# seen holds validated values until the whole file passes. This prevents an early
# automatic-mode value from surviving when a later line makes the config invalid.
# Missing keys keep the schema defaults and are reported for installer maintenance.
read_config() {
  set_config_defaults
  missing_config_defaults=()
  [[ -f $config_file && -r $config_file ]] || { error "Missing or unreadable config: $config_file"; return 2; }
  local line key value entry default_key
  local -A seen=()
  while IFS= read -r line || [[ -n $line ]]; do
    case "$line" in ''|\#*) continue ;; esac
    if [[ ! $line =~ ^([a-z_]+)=(.*)$ ]]; then
      error "Invalid or duplicate config entry: $line"
      return 1
    fi
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]}
    [[ -z ${seen[$key]+x} ]] || { error "Invalid or duplicate config entry: $line"; return 1; }
    validate_config_value "$key" "$value" || return 1
    seen[$key]=$validated_config_value
  done <"$config_file"
  for entry in "${config_defaults[@]}"; do
    default_key=${entry%%=*}
    if [[ -n ${seen[$default_key]+x} ]]; then
      printf -v "$default_key" '%s' "${seen[$default_key]}"
    else
      missing_config_defaults+=("$entry")
    fi
  done
}

# Validate the current config again, then append only defaults for absent keys.
# Existing bytes and values are never rewritten. Symlinks are rejected to avoid
# appending through an unexpected path during installation.
append_missing_config_defaults() {
  read_config || return
  ((${#missing_config_defaults[@]})) || return 0
  [[ -w $config_file && ! -L $config_file ]] || {
    error "Cannot append defaults to config: $config_file"
    return 1
  }
  printf '\n%s\n' "${missing_config_defaults[@]}" >>"$config_file"
}

# Atomically replace the config from a complete associative array named by the
# caller. Every value is validated before a private same-directory file can
# replace the live config, so cancellation or any failed write keeps it intact.
save_config_values() {
  [[ $1 =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || return 2
  local -n values=$1
  local directory temp entry key content
  local -A canonical=()
  [[ ! -L $config_file ]] || { error "Cannot replace symlink config: $config_file"; return 1; }
  if [[ -e $config_file && ( ! -f $config_file || ! -w $config_file ) ]]; then
    error "Cannot replace config: $config_file"
    return 1
  fi
  for entry in "${config_defaults[@]}"; do
    key=${entry%%=*}
    [[ -n ${values[$key]+x} ]] || { error "Missing config value: $key"; return 1; }
    validate_config_value "$key" "${values[$key]}" || return 1
    canonical[$key]=$validated_config_value
  done
  directory=${config_file%/*}
  mkdir -p "$directory" || return 1
  temp=$(mktemp "$directory/.config.XXXXXX") || return 1
  chmod 600 "$temp" || { rm -f -- "$temp"; return 1; }
  content='# Managed by ChatGPT Update Notifier. Checks: 15–10080 in steps of 15; alert: 1–600; shutdown: 1–60; delays: 0–180; rollbacks: 0–1000.'$'\n'
  for entry in "${config_defaults[@]}"; do
    key=${entry%%=*}
    content+="$key=${canonical[$key]}"$'\n'
  done
  printf '%s' "$content" >"$temp" || { rm -f -- "$temp"; return 1; }
  mv -T -- "$temp" "$config_file" || { rm -f -- "$temp"; return 1; }
  for entry in "${config_defaults[@]}"; do
    key=${entry%%=*}
    printf -v "$key" '%s' "${canonical[$key]}"
  done
  missing_config_defaults=()
}

# Tell the user why app checks paused. A bad config cannot supply its own timeout,
# so read_config leaves notification_seconds at the safe 15-second default.
# problem is the short text chosen from read_config's return code.
warn_config() {
  local problem='Config is corrupt'
  [[ $1 == 2 ]] && problem='Config is missing or unreadable'
  send_notification --icon=dialog-warning \
    'ChatGPT update checks paused' "$problem. Please reinstall from: $project_url" ||
    error 'Could not display the config warning notification'
}

# Locate the official ChatGPT APT source and set apt_source for check_apt.
# The package manager, not this text search, verifies repository signatures on refresh.
# file is each readable source definition under APT's standard locations.
find_apt_source() {
  local file
  for file in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
    [[ -r $file ]] || continue
    if grep -qF 'persistent.oaistatic.com/codex-app-prod/linux/deb' "$file"; then
      apt_source=$file
      return 0
    fi
  done
  error 'The official ChatGPT APT source was not found'
  return 1
}

# Refresh only the signed source containing ChatGPT into a user-owned metadata cache.
# apt_options remains available to both the update query and exact-package downloader.
prepare_apt_repository() {
  find_apt_source || return 1
  local lists="$cache_dir/apt-lists"
  mkdir -p "$lists/partial"
  apt_options=(
    -o "Dir::Etc::sourcelist=$apt_source"
    -o 'Dir::Etc::sourceparts=-'
    -o "Dir::State::lists=$lists"
  )
  apt-get "${apt_options[@]}" -o APT::Update::Error-Mode=any update >/dev/null
}

# Refresh the source file containing ChatGPT into a user-owned cache, then set
# installed/candidate. A shared source file may contain other repository entries.
# lists is the isolated metadata directory; options direct both APT tools to it;
# policy is the refreshed package policy, which must name the OpenAI source.
check_apt() {
  installed=$(dpkg-query -W -f='${Version}' chatgpt) || return 1
  local policy
  prepare_apt_repository || return 1
  policy=$(LC_ALL=C apt-cache "${apt_options[@]}" policy chatgpt) || return 1
  grep -qF 'persistent.oaistatic.com/codex-app-prod/linux/deb' <<<"$policy" || {
    error 'The refreshed OpenAI APT source did not provide ChatGPT'
    return 1
  }
  candidate=$(awk '$1 == "Candidate:" { print $2; exit }' <<<"$policy")
  [[ -n $candidate && $candidate != '(none)' ]] || { error 'No ChatGPT candidate in the refreshed APT source'; return 1; }
  dpkg --compare-versions "$candidate" gt "$installed" || candidate=''
}

# Ask only the OpenAI DNF repository for a newer chatgpt package.
# Set installed and candidate; an empty candidate means no available upgrade.
check_fedora() {
  installed=$(rpm -q --qf '%{epochnum}:%{version}-%{release}.%{arch}' chatgpt) || return 1
  candidate=$(dnf -q --refresh --disablerepo='*' --enablerepo=openai-chatgpt \
    repoquery --upgrades --latest-limit=1 --qf '%{epoch}:%{version}-%{release}.%{arch}' chatgpt) || return 1
}

# Use checkupdates' separate database so live pacman metadata is not partially upgraded.
# updates is its text output; status 2 means no updates, while other failures are retried later.
check_arch() {
  installed=$(pacman -Q chatgpt-bin) || return 1
  installed=${installed#chatgpt-bin }
  local updates status=0
  mkdir -p "$cache_dir"
  updates=$(CHECKUPDATES_DB="$cache_dir/checkupdates-db" checkupdates --nocolor) || status=$?
  case $status in 0|2) ;; *) error 'checkupdates failed'; return 1 ;; esac
  candidate=$(awk '$1 == "chatgpt-bin" && $3 == "->" { print $4; exit }' <<<"$updates")
}

# Reset stale version values and dispatch to the current distribution's check.
# The selected checker sets installed/candidate or returns failure to run_check.
check_update() {
  installed='' candidate=''
  case $distro in
    ubuntu|debian) check_apt ;;
    fedora) check_fedora ;;
    arch) check_arch ;;
  esac
}

# Build the exact command arrays for manual or one-click mode in one place.
# One-click uses sudo's authenticated session and noninteractive confirmation;
# Arch deliberately performs a full-system upgrade to avoid partial upgrades.
build_upgrade_command() {
  upgrade_step_one=()
  upgrade_step_two=()
  if [[ ${1:-manual} == automatic ]]; then
    case $distro in
      ubuntu|debian)
        upgrade_step_one=(sudo -n apt-get update)
        upgrade_step_two=(sudo -n apt-get install --only-upgrade -y chatgpt)
        ;;
      fedora) upgrade_step_one=(sudo -n dnf --setopt=keepcache=True upgrade --refresh -y chatgpt) ;;
      arch) upgrade_step_one=(sudo -n pacman -Syu --noconfirm) ;;
    esac
  else
    case $distro in
      ubuntu|debian)
        upgrade_step_one=(sudo apt update)
        upgrade_step_two=(sudo apt install --only-upgrade chatgpt)
        ;;
      fedora) upgrade_step_one=(sudo dnf --setopt=keepcache=True upgrade --refresh chatgpt) ;;
      arch) upgrade_step_one=(sudo pacman -Syu) ;;
    esac
  fi
}

# Print the same arrays run_package_upgrade will execute. The arguments contain
# no whitespace, so joining each array with spaces preserves the familiar command.
# shellcheck disable=SC2120 # The sourced package-operation module passes the operation mode.
upgrade_command() {
  build_upgrade_command "${1:-manual}"
  format_command "${upgrade_step_one[@]}"
  if ((${#upgrade_step_two[@]})); then
    printf ' && '
    format_command "${upgrade_step_two[@]}"
  fi
  printf '\n'
}

# Print one shell-safe command for display. The package operation executes its original
# argument array directly; this rendering is never evaluated as shell input.
format_command() {
  local argument separator=''
  for argument in "$@"; do
    printf '%s%q' "$separator" "$argument"
    separator=' '
  done
}

# Find the first supported desktop terminal and set terminal_app for open_terminal.
# executable is each launcher candidate, ordered to prefer common native terminals.
terminal() {
  local executable
  for executable in konsole ptyxis gnome-terminal x-terminal-emulator xterm; do
    if command -v "$executable" >/dev/null 2>&1; then
      terminal_app=$executable
      return 0
    fi
  done
  return 1
}

# Open this script in a visible terminal with the requested subcommand.
# Package-manager work happens only inside upgrade, after its own confirmation.
# self is the resolved script path and command is the single subcommand to run there.
open_terminal() {
  local self
  local -a command=("$@")
  ((${#command[@]})) || return 2
  self=$(readlink -f -- "$0")
  terminal || return 1
  case $terminal_app in
    konsole|x-terminal-emulator|xterm) "$terminal_app" -e "$self" "${command[@]}" ;;
    ptyxis|gnome-terminal) "$terminal_app" -- "$self" "${command[@]}" ;;
  esac
}

# Apply the same display/listener timeout to both actionable alerts.
# Print notify-send's selected action only when it exits successfully.
# selected_action is discarded when notify-send fails or the listener times out;
# notify_status distinguishes that deadline from other notification failures.
# Status 124 is not proof the desktop popup vanished; it is never a user choice
# and never a reason to write a silence marker.
notify_action() {
  local selected_action='' notify_status=0
  set_notification_options
  selected_action=$(timeout "${notification_seconds}s" notify-send "${notification_options[@]}" "$@") || notify_status=$?
  if (( notify_status )); then
    (( notify_status == 124 )) || error 'Desktop notification failed; the reminder remains eligible'
    return 0
  fi
  printf '%s' "$selected_action"
}

# Ask one yes/no question with a caller-selected default. EOF and unrecognized
# input are always No so a closed terminal can never authorize an action.
# answer is the raw response; suffix makes the default visible before input.
confirm() {
  local answer suffix='[y/N]'
  [[ ${2:-no} == yes ]] && suffix='[Y/n]'
  read -r -p "$1 $suffix " answer || return 1
  case ${answer,,} in
    y|yes) return 0 ;;
    '') [[ ${2:-no} == yes ]] ;;
    *) return 1 ;;
  esac
}

# Show the ChatGPT version change and let the user explicitly silence or open confirmation.
# body stays short for the desktop popup; command_text is kept for terminal-launch failure.
# action is empty on close/expiry, and args omits Install when no terminal is available.
notify_update() {
  local body action='' command_text
  command_text=$(upgrade_command)
  body="$installed → $candidate"
  local args=(--icon=chatgpt --action=silence='Silence this version')
  if terminal; then args+=(--action=install='Install update'); fi
  action=$(notify_action "${args[@]}" 'ChatGPT update available' "$body")
  case $action in
    silence) printf '%s\n' "$candidate" >"$state_dir/silenced-version" ;;
    install) open_terminal upgrade || {
      error "Could not open a terminal. Run: $command_text"
      send_notification 'Open a terminal to update ChatGPT' "$command_text" || true
    } ;;
  esac
}

# Accept a plain three-part release version; reject remote text before using it in URLs.
valid_notifier_version() { [[ $1 =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; }

# Compare two already-validated release versions without treating equality as an update.
# sort -V handles numeric components more reliably than a text comparison.
newer_notifier_version() {
  [[ $1 != "$2" && $(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1) == "$1" ]]
}

# Fetch the small GitHub VERSION file and set latest_notifier_version only if valid.
# The time and size limits keep a bad network response from holding up timer work.
fetch_latest_notifier_version() {
  latest_notifier_version=$(curl -fsSL --max-time 10 --max-filesize 128 "$latest_version_url") || return 1
  valid_notifier_version "$latest_notifier_version" || { error 'Invalid notifier VERSION from GitHub'; return 1; }
}

# Print notes for one version from this project's deliberately small YAML subset.
# notes is the selected text; awk's active/found flags track the matching release
# and reject a changelog that has no notes for that release.
show_changelog() {
  local notes
  notes=$(awk -v target="$2" '
    /^  - version: / { active = ($3 == target); next }
    active && /^      - / { sub(/^      - /, "  - "); print; found = 1 }
    END { if (!found) exit 1 }
  ' "$1") || { error "No changelog notes for $2"; return 1; }
  printf 'What is new in %s:\n%s\n' "$2" "$notes"
}

# Offer a notifier release separately from ChatGPT package updates.
# body carries the version and CLI fallbacks; action is only a clicked button.
# args offers the update button only when a supported terminal is available.
# Closing or expiring the alert leaves silenced-notifier-version unchanged.
notify_notifier_update() {
  local action='' body="Notifier $notifier_version → $latest_notifier_version"$'\n'"Update: ~/.local/bin/$app --update"$'\n'"Dismiss: ~/.local/bin/$app --silence-notifier"
  local args=(--icon=software-update-available --action=dismiss='Dismiss this version')
  if terminal; then args+=(--action=update='Update notifier'); fi
  action=$(notify_action "${args[@]}" 'Notifier update available' "$body")
  case $action in
    dismiss) printf '%s\n' "$latest_notifier_version" >"$state_dir/silenced-notifier-version" ;;
    update) open_terminal --update || error "Could not open a terminal. Run: ~/.local/bin/$app --update" ;;
  esac
}

# Refresh the remote notifier version and record a newer release. Return 0 when an
# update exists, 1 when current, and 2 when GitHub could not provide valid data.
refresh_notifier_update() {
  fetch_latest_notifier_version || return 2
  newer_notifier_version "$latest_notifier_version" "$notifier_version" || return 1
  if ! mkdir -p "$state_dir" ||
    ! printf '%s\n' "$latest_notifier_version" >"$state_dir/last-available-notifier-version"; then
    error 'Could not save notifier update state'
    return 2
  fi
}

# Check the notifier's remote VERSION on every timer tick, independent of app cadence.
# For a newer release, skip its alert when that exact version was dismissed.
check_notifier_update() {
  local status=0
  refresh_notifier_update || status=$?
  case $status in
    1) return 0 ;;
    2) error 'Notifier release check failed; will retry at the next timer tick'; return 0 ;;
  esac
  if is_silenced silenced-notifier-version "$latest_notifier_version"; then return 0; fi
  notify_notifier_update
}

# Download one tagged notifier release and ask before running its installer.
# A subshell keeps the EXIT cleanup trap and temporary paths out of other commands.
# download_dir owns the archive; source_dir holds its extracted files.
# The changelog and exact command appear before confirm asks permission.
update_notifier() (
  fetch_latest_notifier_version || return 1
  if ! newer_notifier_version "$latest_notifier_version" "$notifier_version"; then
    printf 'Notifier %s is up to date.\n' "$notifier_version"
    return 0
  fi
  local download_dir source_dir
  download_dir=$(mktemp -d) || return 1
  trap 'rm -r -- "$download_dir"' EXIT
  source_dir="$download_dir/source"
  mkdir "$source_dir"
  if ! curl -fsSL --max-time 30 \
    "$project_url/archive/refs/tags/v$latest_notifier_version.tar.gz" -o "$download_dir/source.tar.gz" ||
    ! tar -xzf "$download_dir/source.tar.gz" -C "$source_dir" --strip-components=1 ||
    [[ ! -f $source_dir/install.sh || ! -f $source_dir/chatgpt-update-notifier || ! -f $source_dir/CHANGELOG.yaml || ! -f $source_dir/VERSION ||
       ! -f $source_dir/assets/chatgpt-update-notifier.svg ]] ||
    [[ $(<"$source_dir/VERSION") != "$latest_notifier_version" ]]; then
    error 'Could not download a matching notifier release; nothing was installed'
    return 1
  fi
  # The downloaded installer validates its own module inventory. Requiring this
  # release's inventory here would prevent a future release from reorganizing it.
  show_changelog "$source_dir/CHANGELOG.yaml" "$latest_notifier_version" || return 1
  printf '\nCommand: bash %q --release %q\n' "$source_dir/install.sh" "$latest_notifier_version"
  if ! confirm 'Run the notifier installer?'; then printf 'Cancelled.\n'; return 0; fi
  bash "$source_dir/install.sh" --release "$latest_notifier_version"
)

# Check ChatGPT only when the configured interval has elapsed.
# config_status distinguishes missing/unreadable from corrupt config; now/previous
# gate scans, and last-check advances only after a successful package query.
run_check() {
  local config_status=0
  read_config || config_status=$?
  if (( config_status )); then warn_config "$config_status"; return 0; fi
  detect_distro || return 1
  local now previous=0
  now=$(date +%s)
  if [[ -r $state_dir/last-check ]]; then
    read -r previous <"$state_dir/last-check" || true
    [[ $previous =~ ^[0-9]+$ ]] || previous=0
  fi
  if [[ ${1:-scheduled} != force ]] && (( previous <= now && now - previous < interval_minutes * 60 )); then return 0; fi
  if ! check_update; then
    error 'Update check failed; will retry at the next timer tick'
    if [[ ${1:-scheduled} == force ]]; then
      send_notification --icon=dialog-warning 'ChatGPT update check failed' \
        'Could not check the OpenAI package repository. Please try again later.' || true
    fi
    return 1
  fi
  mkdir -p "$state_dir"
  printf '%s\n' "$now" >"$state_dir/last-check"
  if [[ -z $candidate ]]; then
    rm -f -- "$state_dir/last-available-version"
    if [[ ${1:-scheduled} == force ]]; then
      send_notification --icon=chatgpt 'ChatGPT is up to date' "$installed is the newest available version." || true
      printf 'ChatGPT %s is up to date.\n' "$installed"
    fi
    return 0
  fi
  printf '%s\n' "$candidate" >"$state_dir/last-available-version"
  if is_silenced silenced-version "$candidate" && [[ ${1:-scheduled} != force ]]; then return 0; fi
  notify_update
}

# Compare one candidate with its per-stream silence marker. A missing marker
# means this version has not been dismissed; marker is the named state file.
is_silenced() {
  local marker="$state_dir/$1"
  [[ -r $marker && $(<"$marker") == "$2" ]]
}

# Copy a last-offered version into its matching silence marker for either
# update stream. Arguments name the two state files, the missing-version error,
# and the success label; the version itself always comes from the state file.
# version_file is checked before copying so a missing update cannot be silenced.
silence_version() {
  local version_file="$state_dir/$1"
  [[ -s $version_file ]] || { error "$3"; return 1; }
  cp -- "$version_file" "$state_dir/$2"
  printf '%s %s\n' "$4" "$(<"$version_file")"
}

# CLI fallback for silencing the last offered ChatGPT app version.
silence() {
  silence_version last-available-version silenced-version \
    'No known update to silence' 'Silenced ChatGPT update'
}

# CLI fallback for dismissing the last offered notifier release only.
silence_notifier() {
  silence_version last-available-notifier-version silenced-notifier-version \
    'No known notifier update to dismiss' 'Dismissed notifier update'
}

# Remove only explicit dismissal markers. Last-seen versions and check cadence stay,
# so any currently available release may alert again without forcing a network check.
clear_silences() {
  rm -f -- "$state_dir/silenced-version" "$state_dir/silenced-notifier-version" || {
    error 'Could not clear saved silences'
    return 1
  }
  printf 'Silences cleared. Available versions can alert again.\n'
}

# Load only version-matched companion modules. A source checkout uses its adjacent
# core directory; an installed binary uses the data directory populated before it.
load_core_modules() {
  local script_path script_dir installed_path core_dir module
  script_path=$(readlink -f -- "${BASH_SOURCE[0]}") || return 1
  script_dir=${script_path%/*}
  installed_path=$(readlink -m -- "$HOME/.local/bin/$app") || return 1
  if [[ $script_path == "$installed_path" ]]; then
    core_dir="${XDG_DATA_HOME:-$HOME/.local/share}/$app/$notifier_version/core"
  else
    [[ -r $script_dir/VERSION && $(<"$script_dir/VERSION") == "$notifier_version" ]] || {
      error "Missing or mismatched notifier source files. Reinstall from: $project_url"
      return 1
    }
    core_dir="$script_dir/core"
  fi
  for module in "${core_modules[@]}"; do
    [[ -r $core_dir/$module ]] || {
      error "Missing notifier components. Reinstall from: $project_url"
      return 1
    }
  done
  for module in "${core_modules[@]}"; do
    # shellcheck source=/dev/null
    . "$core_dir/$module"
  done
}

# Run the matching installer retained with this release. This entry point remains usable
# even if the separately downloaded installer was deleted or belongs to an older release.
uninstall_notifier() {
  local installer="${XDG_DATA_HOME:-$HOME/.local/share}/$app/$notifier_version/install.sh"
  [[ -r $installer ]] || {
    error "Missing the matching uninstaller. Download the current installer from: $project_url"
    return 1
  }
  exec bash "$installer" --uninstall
}

# Print root-only diagnostic commands even when a companion module needs repair.
show_version() { printf '%s %s\n%s\n' "$app" "$notifier_version" "$project_url"; }

show_help() {
  printf 'Usage: %s [run|check-now|manage|silence|upgrade|rollback [--list|VERSION]|uninstall|--update|--silence-notifier|--version|--help]\n' "$app"
  printf '  run       Check for ChatGPT and notifier updates (default)\n'
  printf '  check-now Check for a ChatGPT update immediately\n'
  printf '  manage    Open the mouse or terminal manager\n'
  printf '  silence   Silence the available ChatGPT app version\n'
  printf '  upgrade   Confirm a ChatGPT app upgrade in this terminal\n'
  printf '  rollback  Choose, list, or restore a saved ChatGPT version\n'
  printf '  uninstall Remove the notifier while keeping config, state, rollback copies, and cache\n'
  printf '  --update  Check for and install a newer notifier release\n'
  printf '  --silence-notifier  Dismiss the available notifier release\n'
  printf 'README: %s#readme\n' "$project_url"
}

# Keep the interactive repair/update flow available before core modules are loaded.
update_notifier_cli() {
  [[ -t 0 ]] || { error 'Run --update in an interactive terminal'; return 1; }
  local status=0
  update_notifier || status=$?
  read -r -p 'Press Enter to close this terminal...' _ || true
  return "$status"
}

# Uninstall and diagnostic/repair commands must work when a module is damaged or missing.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  case ${1:-} in
    uninstall) uninstall_notifier; exit $? ;;
    --version) show_version; exit ;;
    --help|-h) show_help; exit ;;
    --update) update_notifier_cli; exit $? ;;
  esac
fi
load_core_modules

# Route CLI commands. For the timer, load the display duration before forking so
# the notifier check inherits it; run_check separately validates config for app scans.
# status keeps the ChatGPT check result, while notifier_pid is always waited on;
# a notifier failure is logged but cannot prevent the ChatGPT check from starting.
main() {
  case ${1:-run} in
    run)
      local status=0 notifier_pid
      read_config 2>/dev/null || notification_seconds=15
      check_notifier_update & notifier_pid=$!
      run_check || status=$?
      wait "$notifier_pid" || error 'Notifier release check failed; ChatGPT check continued'
      return "$status"
      ;;
    silence) silence ;;
    --silence-notifier) silence_notifier ;;
    upgrade) upgrade ;;
    check-now) run_check force ;;
    rollback) shift; rollback_command "$@" ;;
    manage) manage ;;
    manage-terminal) manager_terminal ;;
    manage-rollback) manage_rollback ;;
    --version) show_version ;;
    --help|-h) show_help ;;
    --update) update_notifier_cli ;;
    *) error 'Use --help for commands'; return 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
